<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Giriş</title>
  <!-- bootstrap linki -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- üst menü-->
<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">Discount Market</a>
    <div class="navbar-nav ms-auto">
      <a class="nav-link active" href="/giris">Giriş</a>
      <a class="nav-link" href="/market-kayit">Market Kayıt</a>
      <a class="nav-link" href="/musteri-kayit">Müşteri Kayıt</a>
    </div>
  </div>
</nav>

<main class="container py-5 sayfa-dar">
  <!-- giris yaparken hata kontrolü-->
  <% if (mesajHata) { %><div class="alert alert-danger"><%= mesajHata %></div><% } %>
  <% if (mesajBasari) { %><div class="alert alert-success"><%= mesajBasari %></div><% } %>
  <% if (hatalar.length > 0) { %>
    <div class="alert alert-danger"><% hatalar.forEach(hata => { %><div><%= hata %></div><% }) %></div>
  <% } %>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <!-- kullanici email giriş-->
      <h3 class="fw-bold mb-3">Giriş Yap</h3>
      <form method="post" action="/giris">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" value="<%= eskiBilgi.email || '' %>" required>
        </div>
        <div class="mb-3">
          <!-- sifre giriş-->
          <label class="form-label">Şifre</label>
          <input type="password" name="sifre" class="form-control" required>
        </div>
        <button class="btn btn-success w-100">Giriş Yap</button>
      </form>
    </div>
  </div>
</main>
</body>
</html>
