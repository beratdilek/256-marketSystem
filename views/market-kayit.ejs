<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Market Kayit</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">Discount Market</a>
    <div class="navbar-nav ms-auto">
      <a class="nav-link" href="/giris">Giriş</a>
      <a class="nav-link active" href="/market-kayit">Market Kayıt</a>
      <a class="nav-link" href="/musteri-kayit">Müşteri Kayıt</a>
    </div>
  </div>
</nav>

<main class="container py-5 sayfa-dar">
  <% if (hatalar.length > 0) { %>
    <div class="alert alert-danger"><% hatalar.forEach(hata => { %><div><%= hata %></div><% }) %></div>
  <% } %>
  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <h3 class="fw-bold mb-3">Market Kaydı</h3>
      <form method="post" action="/market-kayit">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" value="<%= eskiBilgi.email || '' %>" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Market Adı</label>
          <input type="text" name="ad" class="form-control" value="<%= eskiBilgi.ad || '' %>" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Şifre</label>
          <input type="password" name="sifre" class="form-control" required>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Şehir</label>
            <input type="text" name="sehir" class="form-control" value="<%= eskiBilgi.sehir || '' %>" required>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">İlçe</label>
            <input type="text" name="ilce" class="form-control" value="<%= eskiBilgi.ilce || '' %>" required>
          </div>
        </div>
        <button class="btn btn-success w-100">Kayit Ol</button>
      </form>
    </div>
  </div>
</main>
</body>
</html>
