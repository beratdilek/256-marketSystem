<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Profil</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Üst menü kısmı -->

<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">Discount Market</a>
    <div class="navbar-nav ms-auto align-items-center flex-row gap-2">
            <!-- Kullanıcı market ise market paneli, müşteri ise arama ve sepet linkleri göster -->

      <% if (kullanici.rol === 'market') { %>
        <a class="nav-link" href="/market-panel">Market Panel</a>
      <% } else { %>
        <a class="nav-link" href="/arama">Ürün Ara</a>
        <a class="nav-link" href="/sepet">Sepet</a>
      <% } %>
      <a class="nav-link active" href="/profil">Profil</a>
      <form method="post" action="/Çıkış"><button class="btn btn-sm btn-light">Cikis</button></form>
    </div>
  </div>
</nav>

<main class="container py-5 sayfa-dar">
    <!-- Başarı veya hata mesajlarını  yazdırma -->

  <% if (mesajBasari) { %><div class="alert alert-success"><%= mesajBasari %></div><% } %>
  <% if (hatalar.length > 0) { %>
    <div class="alert alert-danger"><% hatalar.forEach(hata => { %><div><%= hata %></div><% }) %></div>
  <% } %>
  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <h3 class="fw-bold mb-3">Profil Bilgileri</h3>

            <!-- Profil bilgilerini güncellemek için  form -->

      <form method="post" action="/profil">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" class="form-control" value="<%= eskiBilgi.email %>" disabled>
        </div>

                <!-- Kullanıcının rolüne göre label kısmı market adı veya ad soyad -->
        <div class="mb-3">
          <label class="form-label"><%= kullanici.rol === 'market' ? 'Market Adı' : 'Ad Soyad' %></label>
          <input type="text" name="ad" class="form-control" value="<%= eskiBilgi.ad || '' %>" required>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Şehir</label>
            <input type="text" name="sehir" class="form-control" value="<%= eskiBilgi.sehir || '' %>" required>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">İlçce</label>
            <input type="text" name="ilce" class="form-control" value="<%= eskiBilgi.ilce || '' %>" required>
          </div>
        </div>
        <button class="btn btn-success w-100">Güncelle</button>
      </form>
    </div>
  </div>
</main>
</body>
</html>
