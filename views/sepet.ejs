<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sepet</title>
    <!--bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!--menü kısmı -->

<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">Discount Market</a>
    <div class="navbar-nav ms-auto align-items-center flex-row gap-2">
      <a class="nav-link" href="/arama">Ürün Ara</a>
      <a class="nav-link active" href="/sepet">Sepet</a>
      <a class="nav-link" href="/profil">Profil</a>
      <form method="post" action="/cikis"><button class="btn btn-sm btn-light">Çıkış</button></form>
    </div>
  </div>
</nav>

<main class="container py-4">
  <h2 class="fw-bold mb-3">Sepetim</h2>
    <!-- AJAX işlemlerinden sonra mesaj gösterme-->
  <div id="ajaxMesaj"></div>

  <% if (sepetUrunleri.length === 0) { %>
      <!-- Sepet boşsa kullanıcıya alert -->
    <div class="alert alert-info">Sepetiniz boş. <a href="/arama">Ürün aramaya gidin.</a></div>
  <% } else { %>
        <!-- Sepetteki ürünleri tek tek listeleme -->
    <div class="table-responsive">
      <table class="table align-middle bg-white shadow-sm rounded overflow-hidden">
        <thead class="table-success">
          <tr>
            <th>ÜrÜn</th>
            <th>Market</th>
            <th>Adet</th>
            <th>Fiyat</th>
            <th>Toplam</th>
            <th>İşlem</th>
          </tr>
        </thead>
        <tbody>
          <% sepetUrunleri.forEach(sepet => { %>
            <tr data-sepet-id="<%= sepet.sepet_id %>">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <img src="<%= sepet.resim_yolu %>" class="sepet-resmi" alt="urun resmi">
                  <div>
                    <strong><%= sepet.baslik %></strong><br>
                    <span class="text-muted small">Stok: <%= sepet.stok %></span>
                  </div>
                </div>
              </td>
              <td><%= sepet.market_adi %></td>
              <td style="width:130px">
                <input type="number" class="form-control adet-input" min="1" max="<%= sepet.stok %>" value="<%= sepet.adet %>">
              </td>
              <td><%= paraYaz(sepet.indirimli_fiyat) %> TL</td>
              <td><strong class="urun-toplam"><%= paraYaz(sepet.urun_toplam) %></strong> TL</td>
              <td>
                <button class="btn btn-outline-danger btn-sm sil-btn">Sil</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

        <!-- Sepetteki ürünlerin genel toplamı  -->
    <div class="card border-0 shadow-sm ms-auto toplam-kart">
      <div class="card-body">
        <div class="d-flex justify-content-between fs-5">
          <span>Genel Toplam</span>
          <strong><span id="genelToplam"><%= paraYaz(genelToplam) %></span> TL</strong>
        </div>
        <button id="satinAlBtn" class="btn btn-success w-100 mt-3">Satın Al</button>
      </div>
    </div>
  <% } %>
</main>

<script src="/sepet.js"></script>
</body>
</html>
