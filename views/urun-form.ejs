<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= formBaslik %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Sayfanın üst menü kısmı -->

<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">Discount Market</a>
    <div class="navbar-nav ms-auto align-items-center flex-row gap-2">
      <a class="nav-link" href="/market-panel">Market Panel</a>
      <a class="nav-link active" href="/urun-ekle">Ürün Ekle</a>
      <a class="nav-link" href="/profil">Profil</a>
      <form method="post" action="/cikis"><button class="btn btn-sm btn-light">Çıkış</button></form>
    </div>
  </div>
</nav>

<main class="container py-5 sayfa-dar">
  <% if (hatalar.length > 0) { %>
      <!-- Formda hata kontorlu-->

    <div class="alert alert-danger"><% hatalar.forEach(hata => { %><div><%= hata %></div><% }) %></div>
  <% } %>
  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      
            <!-- Form başlığı ekleme veya düzenleme durumuna göre gelir -->
      <h3 class="fw-bold mb-3"><%= formBaslik %></h3>

            <!-- Ürün bilgilerini gönderen form -->
      <form method="post" action="<%= formAction %>" enctype="multipart/form-data">
        <div class="mb-3">
          <label class="form-label">Urun Basligi</label>
          <input type="text" name="baslik" class="form-control" value="<%= eskiBilgi.baslik || (urun ? urun.baslik : '') %>" required>
        </div>

                <!-- Ürünün stok ve fiyat bilgileri-->
        <div class="row">
          <div class="col-md-4 mb-3">
            <label class="form-label">Stok</label>
            <input type="number" name="stok" class="form-control" value="<%= eskiBilgi.stok || (urun ? urun.stok : '') %>" min="1" required>
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label">Normal Fiyat</label>
            <input type="number" step="0.01" name="normalFiyat" class="form-control" value="<%= eskiBilgi.normalFiyat || (urun ? urun.normal_fiyat : '') %>" required>
          </div>
          <div class="col-md-4 mb-3">
            <label class="form-label">İndirimli Fiyat</label>
            <input type="number" step="0.01" name="indirimliFiyat" class="form-control" value="<%= eskiBilgi.indirimliFiyat || (urun ? urun.indirimli_fiyat : '') %>" required>
          </div>
        </div>

                <!-- Ürünün son kullanma tarihi belirleme -->
        <div class="mb-3">
          <label class="form-label">Son Kullanma Tarihi</label>
          <input type="date" name="sonKullanmaTarihi" class="form-control" value="<%= eskiBilgi.sonKullanmaTarihi || (urun ? tarihYaz(urun.son_kullanma_tarihi) : '') %>" required>
        </div>

                <!-- Ürün resmi yukleme ve duzenleme modunda gosterme -->
        <div class="mb-3">
          <label class="form-label">Ürün Resmi</label>
          <input type="file" name="resim" class="form-control" accept="image/*">
          <% if (urun) { %>
            <div class="mt-2"><img src="<%= urun.resim_yolu %>" class="kucuk-resim" alt="mevcut resim"></div>
          <% } %>
        </div>
        <button class="btn btn-success w-100">Kaydet</button>
      </form>
    </div>
  </div>
</main>
</body>
</html>
