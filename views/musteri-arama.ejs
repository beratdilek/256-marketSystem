<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ürün Ara</title>
  <!-- bootstrap linki-->

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">Discount Market</a>
    <div class="navbar-nav ms-auto align-items-center flex-row gap-2">
      <a class="nav-link active" href="/arama">Ürün Ara</a>
      <a class="nav-link" href="/sepet">Sepet</a>
      <a class="nav-link" href="/profil">Profil</a>
      <form method="post" action="/cikis"><button class="btn btn-sm btn-light">Çıkış</button></form>
    </div>
  </div>
</nav>

<main class="container py-4">
  <!-- Islem sonucuna gore hata veya basari mesaji -->

  <% if (mesajHata) { %><div class="alert alert-danger"><%= mesajHata %></div><% } %>
  <% if (mesajBasari) { %><div class="alert alert-success"><%= mesajBasari %></div><% } %>

  <h2 class="fw-bold">Urun Ara</h2>
  <!-- Kullanicinin şehrine göre ürünler listeleniyor  -->
  <p class="text-muted">Sadece <strong><%= kullanici.sehir %></strong> Şehrindeki Ürünler listelenir. <%= kullanici.ilce %> ilçesindeki ürünler önce gelir.</p>

  <!-- Müşteri burdan urun ismine gore arama yapabiliyor -->
  <form method="get" action="/arama" class="row g-2 mb-4">
    <div class="col-md-10">
      <input type="text" name="q" class="form-control" placeholder="Ornek: mag" value="<%= aramaKelimesi %>">
    </div>
    <div class="col-md-2">
      <button class="btn btn-success w-100">Ara</button>
    </div>
  </form>

  <div class="mb-3 text-muted"><%= toplamUrun %> Ürün bulundu.</div>

  <% if (urunler.length === 0) { %>
    <div class="alert alert-info">Aramanıza uygun ürün bulunamadı.</div>
  <% } %>

  <div class="row g-3">
    <!-- Bulunan ürünler tek tek kart şeklinde ekrana basiliyor -->

    <% urunler.forEach(urun => { %>
      <div class="col-md-3">
        <div class="card h-100 shadow-sm">
          <img src="<%= urun.resim_yolu %>" class="card-img-top urun-resmi" alt="urun resmi">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= urun.baslik %></h5>
            <p class="small text-muted mb-1"><%= urun.market_adi %></p>
            <p class="small mb-1"><%= urun.sehir %> / <%= urun.ilce %></p>
            <p class="mb-1"><del><%= paraYaz(urun.normal_fiyat) %> TL</del></p>
            <p class="fs-5 fw-bold text-success mb-1"><%= paraYaz(urun.indirimli_fiyat) %> TL</p>
            <p class="small mb-1">Son tarih: <%= tarihYaz(urun.son_kullanma_tarihi) %></p>
            <p class="small text-danger">Kalan gün: <%= urun.kalan_gun %></p>
            <!-- Secilen ürünün id bilgisi gizli input ile sepete ekleme route'una gonderiliyor -->
            <form method="post" action="/sepete-ekle" class="mt-auto">
              <input type="hidden" name="urunId" value="<%= urun.id %>">
              <input type="hidden" name="q" value="<%= aramaKelimesi %>">
              <button class="btn btn-success w-100 btn-sm">Sepete Ekle</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- birden fazla sayfa varsa sayfa numarasi olusturma -->

  <nav class="mt-4">
    <ul class="pagination justify-content-center">
      <% for (let i = 1; i <= toplamSayfa; i++) { %>
        <li class="page-item <%= i === sayfaNo ? 'active' : '' %>">
          <a class="page-link" href="/arama?q=<%= encodeURIComponent(aramaKelimesi) %>&sayfa=<%= i %>"><%= i %></a>
        </li>
      <% } %>
    </ul>
  </nav>
</main>
</body>
</html>
