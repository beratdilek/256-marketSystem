<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Market Panel</title>
    <!-- Bootstrap  -->

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">Market İndirim</a>
        <!-- market kullanıcısının menü linkleri -->

    <div class="navbar-nav ms-auto align-items-center flex-row gap-2">
      <a class="nav-link active" href="/market-panel">Market Panel</a>
      <a class="nav-link" href="/urun-ekle">Ürün Ekle</a>
      <a class="nav-link" href="/profil">Profil</a>

            <!-- çıkkış yapma formu -->
      <form method="post" action="/cikis"><button class="btn btn-sm btn-light">Çıkış</button></form>
    </div>
  </div>
</nav>

<!-- Sayfanın ana içerik kısmı -->

<main class="container py-4">

    <!-- Hata ve başarı mesajları -->

  <% if (mesajHata) { %><div class="alert alert-danger"><%= mesajHata %></div><% } %>
  <% if (mesajBasari) { %><div class="alert alert-success"><%= mesajBasari %></div><% } %>


    <!-- Panel başlığı ve market bilgileri -->

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        

      <h2 class="fw-bold mb-0">Market Paneli</h2>
            <!-- Giriş yapan marketin adı ve konumu  -->

      <p class="text-muted mb-0"><%= kullanici.ad %> - <%= kullanici.sehir %> / <%= kullanici.ilce %></p>
    </div>
        <!-- Yeni ürün ekleme sayfası -->

    <a href="/urun-ekle" class="btn btn-success">Yeni Ürün Ekle</a>
  </div>

  <% if (urunler.length === 0) { %>
    <div class="alert alert-info">Henüz ürün eklenmemiş.</div>
  <% } %>

  <div class="row g-3">
        <!-- Ürünler burada listeleniyor tek tek -->

    <% urunler.forEach(urun => { %>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm <%= urun.tarihi_gecti_mi ? 'expired-card' : '' %>">
          <img src="<%= urun.resim_yolu %>" class="card-img-top urun-resmi" alt="urun resmi">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <h5 class="card-title"><%= urun.baslik %></h5>
                            <!-- Ürünün son kullanma durumuna göre bilgilendirme -->

              <% if (urun.tarihi_gecti_mi) { %>
                <span class="badge text-bg-danger">Tarihi Geçmiş</span>
              <% } else { %>
                <span class="badge text-bg-success"><%= urun.kalan_gun %> gün</span>
              <% } %>
            </div>
            <p class="mb-1">Stok: <strong><%= urun.stok %></strong></p>
            <p class="mb-1">Normal: <del><%= paraYaz(urun.normal_fiyat) %> TL</del></p>
            <p class="mb-1">İndirimli: <strong><%= paraYaz(urun.indirimli_fiyat) %> TL</strong></p>
            <p class="text-muted">Son tarih: <%= tarihYaz(urun.son_kullanma_tarihi) %></p>
            <div class="d-flex gap-2">
                          <!-- Ürün düzenleme ve silme  -->

              <a href="/urun-duzenle/<%= urun.id %>" class="btn btn-outline-primary btn-sm">Duzenle</a>
              <form method="post" action="/urun-sil/<%= urun.id %>" onsubmit="return confirm('Urun silinsin mi?')">
                <button class="btn btn-outline-danger btn-sm">Sil</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</main>
</body>
</html>
