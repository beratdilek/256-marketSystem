<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Email Dogrula</title>
  <!-- bootstrap linki -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"> 
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- ustteki menu kismi -->
<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">Discount Market</a>
    <div class="navbar-nav ms-auto">
      <a class="nav-link" href="/giris">Giriş</a>
      <a class="nav-link" href="/market-kayit">Market Kayıt</a>
      <a class="nav-link" href="/musteri-kayit">Müşteri Kayıt</a>
    </div>
  </div>
</nav>

<main class="container py-5 sayfa-dar">
  <!-- hata ve başarı mesajları check -->
  <% if (mesajBasari) { %><div class="alert alert-success"><%= mesajBasari %></div><% } %>
  <% if (hatalar.length > 0) { %>
    <div class="alert alert-danger"><% hatalar.forEach(hata => { %><div><%= hata %></div><% }) %></div>
  <% } %>
  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <h3 class="fw-bold mb-3">Email Doğrula</h3>

      <!-- kullanici mail ve kodu alma -->

      <form method="post" action="/email-dogrula">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" value="<%= eskiBilgi.email || '' %>" required> 
        </div>
        <div class="mb-3">
          <label class="form-label">Doğrulama Kodu</label>
          <input type="text" name="kod" class="form-control" maxlength="6" required>
        </div>
        <button class="btn btn-success w-100">Doğrula</button>
      </form>
    </div>
  </div>
</main>
</body>
</html>
